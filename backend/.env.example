# Environment variables for GeestuJob Backend
PROJECT_NAME="GeestuJob API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=geestu_job

# Full Database URL (overrides individual POSTGRES_* params if set)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geestu_job
